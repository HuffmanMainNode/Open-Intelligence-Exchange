{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Open-Intelligence-Exchange/schemas/prekey-bundle.schema.json",
  "title": "OIX signed one-time X25519 prekey bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signature"],
  "properties": {
    "signature": { "type": "string", "minLength": 80, "maxLength": 100 },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "agent_id", "algorithm", "created_at", "expires_at", "keys"],
      "properties": {
        "protocol": { "const": "OIX" },
        "version": { "const": "1.0" },
        "agent_id": { "type": "string", "pattern": "^ed25519:[0-9a-f]{64}$" },
        "algorithm": { "const": "X25519" },
        "created_at": { "type": "integer", "minimum": 0 },
        "expires_at": { "type": "integer", "minimum": 1 },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "public_key"],
            "properties": {
              "key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "public_key": { "type": "string", "minLength": 43, "maxLength": 43 }
            }
          }
        }
      }
    }
  }
}
