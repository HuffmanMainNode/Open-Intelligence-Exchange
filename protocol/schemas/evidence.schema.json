{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OIX evidence provenance record",
  "type": "object",
  "required": ["evidence_id", "content_sha256", "source_uri", "collected_at", "collector_id", "collector_version", "method", "status", "limitations"],
  "properties": {
    "evidence_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_uri": {"type": "string", "minLength": 1},
    "collected_at": {"type": "string", "format": "date-time"},
    "source_timestamp": {"type": ["string", "null"]},
    "collector_id": {"type": "string", "minLength": 1},
    "collector_version": {"type": "string"},
    "method": {"type": "string", "minLength": 1},
    "status": {"enum": ["observed", "verified", "unverified", "disputed", "unknown"]},
    "limitations": {"type": "string"}
  },
  "additionalProperties": false
}
