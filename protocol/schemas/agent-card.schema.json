{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Open-Intelligence-Exchange/schemas/agent-card.schema.json",
  "title": "OIX v0.1 signed agent card",
  "type": "object",
  "additionalProperties": false,
  "required": ["card", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 80, "maxLength": 100},
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "protocol_version", "agent_id", "display_name", "public_key", "key_algorithm", "capabilities"],
      "properties": {
        "protocol": {"const": "OIX"},
        "protocol_version": {"const": "0.1"},
        "agent_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
        "public_key": {"type": "string", "minLength": 43, "maxLength": 44},
        "key_algorithm": {"const": "ed25519"},
        "capabilities": {"type": "array", "items": {"type": "string", "maxLength": 128}, "uniqueItems": true, "maxItems": 128}
      }
    }
  }
}
