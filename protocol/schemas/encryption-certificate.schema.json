{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Open-Intelligence-Exchange/protocol/schemas/encryption-certificate.schema.json",
  "title": "OIX X25519 Encryption Key Certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "agent_id", "algorithm", "public_key", "issued_at", "expires_at"],
      "properties": {
        "protocol": {"const": "OIX"},
        "version": {"const": "1.0"},
        "agent_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "algorithm": {"const": "X25519"},
        "public_key": {"type": "string", "minLength": 43, "maxLength": 44},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1}
      }
    },
    "signature": {"type": "string", "minLength": 80, "maxLength": 90}
  }
}
