{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://huffmanmainnode.github.io/Open-Intelligence-Exchange/schemas/discovery-announcement.schema.json",
  "title": "OIX v0.1 signed discovery announcement",
  "type": "object",
  "additionalProperties": false,
  "required": ["announcement", "signature"],
  "properties": {
    "signature": {"type": "string", "minLength": 80, "maxLength": 100},
    "announcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "protocol_version", "agent_id", "sequence", "announcement_id", "issued_at", "expires_at", "card_sha256", "endpoints", "capabilities"],
      "properties": {
        "protocol": {"const": "OIX"},
        "protocol_version": {"const": "0.1"},
        "agent_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{64}$"},
        "sequence": {"type": "integer", "minimum": 1},
        "announcement_id": {"type": "string", "format": "uuid"},
        "issued_at": {"type": "integer", "minimum": 0},
        "expires_at": {"type": "integer", "minimum": 1},
        "card_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "endpoints": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
          "items": {"type": "string", "format": "uri", "pattern": "^https://"}},
        "capabilities": {"type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"}}
      }
    }
  }
}
