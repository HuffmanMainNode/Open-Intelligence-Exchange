{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/HuffmanMainNode/Open-Intelligence-Exchange/blob/main/schemas/evidence-submit.schema.json",
  "title": "OIX Evidence Submission Payload 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_type",
    "source_uri",
    "source_timestamp",
    "collected_at",
    "collector",
    "method",
    "artifact",
    "classification",
    "status",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "evidence_id": { "type": "string", "format": "uuid" },
    "evidence_type": {
      "enum": [
        "file_manifest",
        "domain_observation",
        "transaction_analysis",
        "evm_transaction_inspection",
        "sbom_analysis"
      ]
    },
    "source_uri": { "type": ["string", "null"], "format": "uri", "maxLength": 2048 },
    "source_timestamp": { "type": ["string", "null"], "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes", "media_type"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 1000000000000 },
        "media_type": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "classification": { "enum": ["public", "internal", "restricted"] },
    "status": { "enum": ["observed", "derived", "unverified"] },
    "summary": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "integer" },
        { "type": "string" },
        {
          "type": "array",
          "maxItems": 1000,
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "maxProperties": 1000,
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
